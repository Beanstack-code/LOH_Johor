APP_NAME="柔佛州羅氏公会"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Required for mobile API auth (member/merchant JWT). Generate with: php artisan jwt:secret
JWT_SECRET=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional alternative to path (single-line JSON string)
FIREBASE_SERVICE_ACCOUNT_JSON=

# PayCools (payment gateway)
PAYCOOLS_APP_ID=
# Multi-line PEM merchant private key. Quote with newlines escaped.
PAYCOOLS_PRIVATE_KEY=
# Multi-line PEM PayCools platform public key (verifies webhook signatures).
PAYCOOLS_PUBLIC_KEY=
PAYCOOLS_BASE_URL=https://sandbox.paycools.com
# Production: https://openapi.paycools.com — sandbox/UAT: use the URL from PayCools docs.
# PayCools rejects API calls from IPs not on your merchant whitelist (error 1002 / 21016).
# For local `php artisan serve`, add your machine's public IP in the PayCools merchant portal.
# Hosted-checkout return URL (PayCools redirects here after payment).
# Must match Flutter: _kPaycoolsReturnUrlPrefix in subscription_screen.dart + donation_amount_screen.dart
# Add GET /paycools/return in routes/web.php so this URL does not 404.
PAYCOOLS_RETURN_URL=https://pkpms.com/paycools/return

# PayCools server-to-server webhook (register the same URL in the PayCools merchant portal).
# Only one URL is used for both flows — pick the route for the payment type you are testing:
#   Subscription: https://pkpms.com/api/v1/subscription/paycools/webhook
#   Donation:     https://pkpms.com/api/v1/campaigns/donate/paycools/webhook
# Do NOT use /api/v1/paycools/webhook (that route does not exist).
PAYCOOLS_NOTIFY_URL=https://pkpms.com/api/v1/campaigns/donate/paycools/webhook

PAYCOOLS_COUNTRY_CODE=MY
PAYCOOLS_CURRENCY=MYR
PAYCOOLS_SETTLEMENT_CURRENCY=MYR

# Set to true in production to disable the legacy /subscribe direct-activation route.
# MUST be true on any live server — keeps the gateway mandatory.
PAYMENTS_REQUIRED=false

# Set to true to disable legacy direct donation writes and force PayCools flow:
# POST /campaigns/{id}/donate/paycools/order -> status -> webhook.
DONATION_PAYMENTS_REQUIRED=true

# Minutes after which a pending payment transaction is automatically marked as failed.
# 30 is a safe default for hosted-checkout flows.
STALE_PAYMENT_TTL_MINUTES=30

# Optional local development seed accounts. Leave blank outside local development.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_OPERATIONS_ADMIN_EMAIL=
SEED_OPERATIONS_ADMIN_PASSWORD=
DEMO_DATA_PASSWORD=
TEST_USERS_PASSWORD=
